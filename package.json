{
  "name": "yuancode",
  "version": "0.1.0",
  "private": true,
  "description": "A nano Claude Code-like agent harness for building projects from 0 to 1",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.10.0"
  },
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "yuancode": "./bin/yuancode.mjs"
  },
  "main": "./dist/main.js",
  "exports": {
    ".": "./dist/main.js",
    "./cli": "./dist/cli/index.js",
    "./core": "./dist/core/index.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/",
    "skills/",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node bin/yuancode.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint placeholder'",
    "yuancode": "tsx src/main.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^5.0.1",
    "ink-text-input": "^6.0.0",
    "openai": "^4.80.0",
    "pino": "^9.5.0",
    "react": "^18.3.1",
    "tiktoken": "^1.0.20",
    "uuid": "^11.0.3",
    "yaml": "^2.6.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
