# =============================================================================
# YuanCode environment configuration template
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env       # macOS/Linux
#     copy .env.example .env     # Windows
# Or just run `yuancode init` and the wizard will write this for you.
# =============================================================================

# --- Model provider API key (REQUIRED) ---------------------------------------
# Get one from your provider. The key is also read from $YUANCODE_API_KEY env
# if this line is left empty.
# Examples:
#   sk-ant-api03-...          # Anthropic
#   sk-proj-...               # OpenAI
#   sk-api-...                # MiniMax / other compatible providers
YUANCODE_API_KEY=sk-cp-REPLACE-WITH-YOUR-KEY

# --- Active provider selection ------------------------------------------------
# Allowed: minimax | anthropic | openai | custom
YUANCODE_PROVIDER=minimax

# --- Model id (override per provider) -----------------------------------------
YUANCODE_MODEL=MiniMax-M3

# --- Provider base URL -------------------------------------------------------
# Leave empty to use each provider's default endpoint.
YUANCODE_BASE_URL=https://api.minimaxi.com/anthropic

# --- Permission mode ----------------------------------------------------------
# Allowed: manual | acceptEdits | auto | plan
YUANCODE_PERMISSION_MODE=acceptEdits

# --- Limits -------------------------------------------------------------------
YUANCODE_MAX_STEPS=50
YUANCODE_TOTAL_TIMEOUT_MS=1800000
YUANCODE_PER_STEP_TIMEOUT_MS=60000
YUANCODE_MAX_COST_USD=5.0
YUANCODE_MAX_PARALLEL_TOOLS=8

# --- Sandbox ------------------------------------------------------------------
# Allowed: local | bubblewrap | docker | landlock
YUANCODE_SANDBOX=local

# --- Sandbox docker image (only when YUANCODE_SANDBOX=docker) -----------------
YUANCODE_SANDBOX_IMAGE=yuancode/sandbox:latest

# --- Logging ------------------------------------------------------------------
# Allowed: trace | debug | info | warn | error | silent
YUANCODE_LOG_LEVEL=info
YUANCODE_LOG_FILE=.yuancode/logs/yuancode.log

# --- MCP servers (advanced; prefer `.yuancode/mcp.json` per-project) ----------
# Example GitHub token:
# GITHUB_TOKEN=
